#!/usr/bin/env bash
set -euo pipefail

# Assistant — wrapper to launch pi with pigram, self-contained in this repo.
#
# Usage:
#   ./Assistant init   — ask for provider/model/api-key, save to .env (overwrites)
#   ./Assistant update — update this script + skills + pigram from template repo
#   ./Assistant        — launch pi with saved .env (fails if missing)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PI_VERSION="0.84.4"
PI_PKG="@earendil-works/pi-coding-agent@${PI_VERSION}"
PIGRAM_PKG="git:github.com/galiprandi/pigram"
TEMPLATE_REPO="galiprandi/assistant"
TEMPLATE_RAW="https://raw.githubusercontent.com/${TEMPLATE_REPO}/main"
ENV_FILE="$SCRIPT_DIR/.env"
PI_DIR="$SCRIPT_DIR/.pi"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}$*${NC}"; }
ok()    { echo -e "${GREEN}$*${NC}"; }
warn()  { echo -e "${YELLOW}$*${NC}"; }
error() { echo -e "${RED}$*${NC}" >&2; }

# --- Init git submodules (pigram source for reference) ---
init_submodules() {
  if [ -f "$SCRIPT_DIR/.gitmodules" ] && [ ! -f "$SCRIPT_DIR/pigram/package.json" ]; then
    info "Initializing submodules..."
    git submodule update --init --recursive
  fi
}

# --- Install/reinstall pigram from fork (remove npm version first if present) ---
ensure_pigram() {
  # Remove npm version if installed — avoids loading the buggy upstream
  if grep -q "npm:@jetmiky/pigram" "$PI_DIR/settings.json" 2>/dev/null; then
    info "Removing npm pigram (replacing with fork)..."
    PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" remove "npm:@jetmiky/pigram" 2>/dev/null || true
  fi
  # Install from fork if not already installed
  if ! grep -q "git:github.com/galiprandi/pigram" "$PI_DIR/settings.json" 2>/dev/null; then
    info "Installing pigram from fork ($PIGRAM_PKG)..."
    PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" install "$PIGRAM_PKG"
    ok "pigram installed."
  else
    ok "pigram already installed from fork."
  fi
}

# --- Load .env ---
load_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
    return 0
  fi
  return 1
}

# --- Ask for config and save to .env (overwrites if exists) ---
cmd_init() {
  init_submodules
  ensure_pigram

  # Copy AGENTS.example.md → AGENTS.md if not present
  if [ ! -f "$SCRIPT_DIR/AGENTS.md" ] && [ -f "$SCRIPT_DIR/AGENTS.example.md" ]; then
    cp "$SCRIPT_DIR/AGENTS.example.md" "$SCRIPT_DIR/AGENTS.md"
    ok "Created AGENTS.md from template (AGENTS.example.md)."
  fi

  echo ""
  if [ -f "$ENV_FILE" ]; then
    warn "Existing .env found — overwriting."
    echo ""
  else
    info "First-time setup — let's configure your assistant."
    echo ""
  fi

  echo "Available providers: anthropic, openai, google, groq, nvidia, openrouter, mistral, xai, deepseek"
  read -rp "Provider (e.g. anthropic): " PROVIDER
  PROVIDER="${PROVIDER:-anthropic}"

  read -rp "Model ID (e.g. claude-sonnet-4-5-20250929, or leave empty to pick later): " MODEL
  MODEL="${MODEL:-}"

  local env_var_name
  env_var_name=$(echo "${PROVIDER}_API_KEY" | tr '[:lower:]' '[:upper:]')
  read -rsp "API key for ${PROVIDER} (saved as ${env_var_name}): " API_KEY
  echo ""
  if [ -z "$API_KEY" ]; then
    error "API key is required."
    exit 1
  fi

  {
    echo "# Assistant configuration — generated by ./Assistant init"
    echo "# Do NOT commit this file (it's in .gitignore)"
    echo "PI_PROVIDER=${PROVIDER}"
    [ -n "$MODEL" ] && echo "PI_MODEL=${MODEL}"
    echo "${env_var_name}=${API_KEY}"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  ok "Saved to $ENV_FILE"
}

# --- Update: download latest Assistant script + update skills + sync pigram ---
# This works for template-based repos (no shared git history with the template).
# Only downloads the Assistant script itself — your AGENTS.md, .env, and other
# files are never touched.
cmd_update() {
  local resourced=false
  [[ "${2:-}" == "--resourced" ]] && resourced=true

  # 1. Download latest files from template repo
  if [[ "$resourced" == false ]]; then
    local changed=false

    # Download Assistant script
    info "Checking for Assistant script updates..."
    local tmp_script
    tmp_script=$(mktemp)
    if curl -fsSL "$TEMPLATE_RAW/Assistant" -o "$tmp_script"; then
      if ! diff -q "$tmp_script" "$SCRIPT_DIR/Assistant" &>/dev/null; then
        cp "$tmp_script" "$SCRIPT_DIR/Assistant"
        chmod +x "$SCRIPT_DIR/Assistant"
        ok "Assistant script updated."
        changed=true
      else
        ok "Assistant script already up to date."
      fi
    else
      warn "Could not download Assistant script — continuing with current version."
    fi
    rm -f "$tmp_script"

    # Download AGENTS.example.md
    info "Checking for AGENTS.example.md updates..."
    local tmp_example
    tmp_example=$(mktemp)
    if curl -fsSL "$TEMPLATE_RAW/AGENTS.example.md" -o "$tmp_example"; then
      if ! diff -q "$tmp_example" "$SCRIPT_DIR/AGENTS.example.md" &>/dev/null 2>&1; then
        cp "$tmp_example" "$SCRIPT_DIR/AGENTS.example.md"
        ok "AGENTS.example.md updated."
        changed=true
      else
        ok "AGENTS.example.md already up to date."
      fi
    else
      warn "Could not download AGENTS.example.md — continuing with current version."
    fi
    rm -f "$tmp_example"

    # Re-exec if the script changed so new PI_VERSION etc. apply now
    if [[ "$changed" == true ]]; then
      exec "$0" update --resourced
    fi
  else
    ok "Running updated script."
  fi

  # Check if AGENTS.example.md changed (user should review)
  if [ -f "$SCRIPT_DIR/AGENTS.example.md" ] && [ -f "$SCRIPT_DIR/AGENTS.md" ]; then
    local example_hash_file="$PI_DIR/.agents-example.sha256"
    local current_hash
    current_hash=$(sha256sum "$SCRIPT_DIR/AGENTS.example.md" | cut -d' ' -f1)
    local saved_hash=""
    [ -f "$example_hash_file" ] && saved_hash=$(cat "$example_hash_file")
    if [[ "$current_hash" != "$saved_hash" ]]; then
      echo ""
      warn "AGENTS.example.md has been updated."
      warn "Review the '## Novedades' section and copy what you want to AGENTS.md."
      mkdir -p "$PI_DIR"
      echo "$current_hash" > "$example_hash_file"
    fi
  fi

  # 2. Update skills
  echo ""
  info "Updating skills..."
  npx skills update -y

  # Restore from lock file if any skills are missing
  if ! npx skills list 2>/dev/null | grep -q "SKILL.md"; then
    warn "Some skills missing — restoring from lock file..."
    npx skills experimental_install -y
  fi

  # 3. Sync pigram from fork (always reinstall to pick up fixes)
  echo ""
  info "Syncing pigram from fork..."
  # Remove npm version if present
  if grep -q "npm:@jetmiky/pigram" "$PI_DIR/settings.json" 2>/dev/null; then
    info "Removing npm pigram (replacing with fork)..."
    PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" remove "npm:@jetmiky/pigram" 2>/dev/null || true
  fi
  # Remove fork version so reinstall pulls latest
  if grep -q "git:github.com/galiprandi/pigram" "$PI_DIR/settings.json" 2>/dev/null; then
    PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" remove "git:github.com/galiprandi/pigram" 2>/dev/null || true
  fi
  PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" install "$PIGRAM_PKG"
  ok "pigram synced from fork."

  echo ""
  ok "Update complete."
}

# --- Launch pi with saved config ---
cmd_run() {
  if ! load_env; then
    error "No .env found. Run ./Assistant init first."
    exit 1
  fi

  init_submodules
  ensure_pigram

  local args=()
  [ -n "${PI_PROVIDER:-}" ] && args+=(--provider "$PI_PROVIDER")
  [ -n "${PI_MODEL:-}" ]    && args+=(--model "$PI_MODEL")

  info "Launching pi..."
  exec env PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" "${args[@]}"
}

# --- Dispatch ---
case "${1:-}" in
  init)   cmd_init ;;
  update) cmd_update "$@" ;;
  "")     cmd_run ;;
  *)
    error "Unknown command: $1"
    echo "Usage: ./Assistant [init|update]" >&2
    exit 1
    ;;
esac
