#!/usr/bin/env bash
set -euo pipefail

# Assistant — wrapper to launch pi with pigram, self-contained in this repo.
#
# Usage:
#   ./Assistant init   — ask for provider/model/api-key, save to .env (overwrites)
#   ./Assistant        — launch pi with saved .env (fails if missing)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PI_VERSION="0.84.4"
PI_PKG="@earendil-works/pi-coding-agent@${PI_VERSION}"
PIGRAM_PKG="git:github.com/galiprandi/pigram"
ENV_FILE="$SCRIPT_DIR/.env"
PI_DIR="$SCRIPT_DIR/.pi"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}$*${NC}"; }
ok()    { echo -e "${GREEN}$*${NC}"; }
warn()  { echo -e "${YELLOW}$*${NC}"; }
error() { echo -e "${RED}$*${NC}" >&2; }

# --- Init git submodules (pigram source for reference) ---
init_submodules() {
  if [ -f "$SCRIPT_DIR/.gitmodules" ] && [ ! -f "$SCRIPT_DIR/pigram/package.json" ]; then
    info "Initializing submodules..."
    git submodule update --init --recursive
  fi
}

# --- Install/reinstall pigram from fork ---
ensure_pigram() {
  info "Installing pigram from fork ($PIGRAM_PKG)..."
  PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" install "$PIGRAM_PKG"
  ok "pigram installed."
}

# --- Load .env ---
load_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
    return 0
  fi
  return 1
}

# --- Ask for config and save to .env (overwrites if exists) ---
cmd_init() {
  init_submodules
  ensure_pigram

  echo ""
  if [ -f "$ENV_FILE" ]; then
    warn "Existing .env found — overwriting."
    echo ""
  else
    info "First-time setup — let's configure your assistant."
    echo ""
  fi

  echo "Available providers: anthropic, openai, google, groq, nvidia, openrouter, mistral, xai, deepseek"
  read -rp "Provider (e.g. anthropic): " PROVIDER
  PROVIDER="${PROVIDER:-anthropic}"

  read -rp "Model ID (e.g. claude-sonnet-4-5-20250929, or leave empty to pick later): " MODEL
  MODEL="${MODEL:-}"

  local env_var_name
  env_var_name=$(echo "${PROVIDER}_API_KEY" | tr '[:lower:]' '[:upper:]')
  read -rsp "API key for ${PROVIDER} (saved as ${env_var_name}): " API_KEY
  echo ""
  if [ -z "$API_KEY" ]; then
    error "API key is required."
    exit 1
  fi

  {
    echo "# Assistant configuration — generated by ./Assistant init"
    echo "# Do NOT commit this file (it's in .gitignore)"
    echo "PI_PROVIDER=${PROVIDER}"
    [ -n "$MODEL" ] && echo "PI_MODEL=${MODEL}"
    echo "${env_var_name}=${API_KEY}"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  ok "Saved to $ENV_FILE"
}

# --- Update: pull repo + update skills + sync pigram ---
cmd_update() {
  # Refuse if there are uncommitted changes
  if ! git diff --quiet || ! git diff --staged --quiet; then
    warn "Uncommitted changes detected. Commit or stash before updating:"
    git status --short
    exit 1
  fi

  # Determine which remote to pull from (prefer upstream for forks)
  local remote="origin"
  if git remote get-url upstream &>/dev/null; then
    remote="upstream"
  fi
  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)

  info "Fetching from $remote..."
  git fetch "$remote" "$branch" 2>/dev/null

  local local_ref remote_ref
  local_ref=$(git rev-parse HEAD)
  remote_ref=$(git rev-parse "$remote/$branch" 2>/dev/null || echo "")

  if [[ -z "$remote_ref" ]]; then
    error "No remote branch $remote/$branch found."
    exit 1
  fi

  if [[ "$local_ref" == "$remote_ref" ]]; then
    ok "Already up to date ($branch @ ${local_ref:0:7})"
  else
    local behind
    behind=$(git rev-list --count HEAD.."$remote/$branch")
    info "↓  $behind commit(s) behind $remote/$branch"
    info "Pulling..."
    git pull "$remote" "$branch" --ff-only
    ok "Pulled latest."
  fi

  # Update skills
  echo ""
  info "Updating skills..."
  npx skills update -y

  # Restore from lock file if any skills are missing
  if ! npx skills list 2>/dev/null | grep -q "SKILL.md"; then
    warn "Some skills missing — restoring from lock file..."
    npx skills experimental_install -y
  fi

  # Sync pigram from fork
  echo ""
  ensure_pigram

  echo ""
  ok "Update complete ($(git rev-parse --short HEAD))"
}

# --- Launch pi with saved config ---
cmd_run() {
  if ! load_env; then
    error "No .env found. Run ./Assistant init first."
    exit 1
  fi

  init_submodules
  ensure_pigram

  local args=()
  [ -n "${PI_PROVIDER:-}" ] && args+=(--provider "$PI_PROVIDER")
  [ -n "${PI_MODEL:-}" ]    && args+=(--model "$PI_MODEL")

  info "Launching pi..."
  exec env PI_CODING_AGENT_DIR="$PI_DIR" npx --yes "$PI_PKG" "${args[@]}"
}

# --- Dispatch ---
case "${1:-}" in
  init)   cmd_init ;;
  update) cmd_update ;;
  "")     cmd_run ;;
  *)
    error "Unknown command: $1"
    echo "Usage: ./Assistant [init|update]" >&2
    exit 1
    ;;
esac
