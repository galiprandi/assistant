#!/usr/bin/env bash
set -euo pipefail

# This repo is the default project.
REPO_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"

# Keep pi-web credentials and config inside the project (not tracked by git).
PI_DIR="$REPO_DIR/.pi-web"
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$PI_DIR}"

# On first run, seed .pi-web/ with existing provider/model config from ~/.pi/agent.
if [ ! -d "$PI_DIR" ]; then
  mkdir -p "$PI_DIR"
  if [ -f "$HOME/.pi/agent/models.json" ]; then
    cp "$HOME/.pi/agent/models.json" "$PI_DIR/models.json"
  fi
fi

# Launch pi-web without auto-opening the browser, then open it ourselves with
# ?cwd= so this repo is the default project.
export PI_WEB_NO_OPEN=1
npx @agegr/pi-web@latest -p 10000 &
PI_PID=$!

# Wait for the server to be ready, then open the browser with the repo as cwd.
URL="http://127.0.0.1:10000?cwd=$REPO_DIR"
for _ in $(seq 1 30); do
  if curl -sf -o /dev/null "$URL"; then
    break
  fi
  sleep 0.5
done

if command -v open >/dev/null 2>&1; then
  open "$URL"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL"
fi

wait "$PI_PID"
